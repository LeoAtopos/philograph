/* pages/index/index.wxss */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #0f1117;
  position: relative;
}

/* ===== 顶部导航栏 ===== */
.topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx 12rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  background: linear-gradient(to bottom, rgba(15,17,23,0.97) 70%, rgba(15,17,23,0));
  z-index: 20;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.logo {
  font-size: 48rpx;
  color: #c8a96e;
  font-family: "Palatino Linotype", Georgia, serif;
  line-height: 1;
}

.title-main {
  font-size: 30rpx;
  font-weight: 700;
  color: #e8eaf0;
  display: block;
  line-height: 1.2;
}

.title-sub {
  font-size: 18rpx;
  color: #5a6282;
  display: block;
}

.title-group {
  display: flex;
  flex-direction: column;
}

/* ===== 语言按钮 ===== */
.lang-btn {
  padding: 8rpx 22rpx;
  border-radius: 44rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.lang-btn.active {
  color: #c8a96e;
  font-weight: 600;
  background: rgba(200,169,110,0.15);
}

.switcher-sep {
  width: 1rpx;
  height: 28rpx;
  background: #2a2d3e;
  margin: 0 4rpx;
}

/* ===== 传统切换 ===== */
.tradition-switcher {
  position: fixed;
  top: calc(100rpx + env(safe-area-inset-top));
  left: 32rpx;
  display: flex;
  align-items: center;
  background: rgba(26,29,46,0.95);
  border-radius: 50rpx;
  padding: 4rpx;
  z-index: 20;
  border: 1rpx solid #2a2d3e;
  gap: 4rpx;
}

.switcher-btn {
  padding: 8rpx 28rpx;
  font-size: 22rpx;
  color: #6b7280;
  border-radius: 44rpx;
}

.switcher-btn.active {
  background: #2a2d3e;
  color: #c8a96e;
  font-weight: 600;
}

/* ===== 搜索+筛选栏 ===== */
.search-row {
  position: fixed;
  top: calc(168rpx + env(safe-area-inset-top));
  left: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 20;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(26,29,46,0.95);
  border-radius: 50rpx;
  padding: 0 24rpx;
  height: 64rpx;
  border: 1rpx solid #2a2d3e;
}

.search-icon { font-size: 28rpx; margin-right: 12rpx; color: #5a6282; }

.search-input {
  flex: 1;
  font-size: 24rpx;
  color: #e8eaf0;
  background: transparent;
}

.search-placeholder { color: #5a6282; }

.search-clear {
  font-size: 36rpx;
  color: #5a6282;
  padding: 0 4rpx;
}

.filter-btn, .index-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(26,29,46,0.95);
  border: 1rpx solid #2a2d3e;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #9ca3b8;
  position: relative;
  flex-shrink: 0;
}

.filter-btn.active {
  border-color: #c8a96e;
  color: #c8a96e;
}

.filter-count {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  background: #c8a96e;
  color: #0f1117;
  font-size: 16rpx;
  font-weight: 700;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* ===== 筛选面板 ===== */
.filter-panel {
  position: fixed;
  top: calc(236rpx + env(safe-area-inset-top));
  left: 24rpx;
  right: 24rpx;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background: rgba(19,21,32,0.98);
  border-radius: 0 0 16rpx 16rpx;
  border: 1rpx solid #2a2d3e;
  border-top: none;
  z-index: 20;
}

.filter-panel.open {
  max-height: 500rpx;
  padding: 20rpx;
  overflow-y: auto;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.filter-title {
  font-size: 22rpx;
  color: #9ca3b8;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.filter-actions { display: flex; gap: 12rpx; }

.btn-small {
  padding: 4rpx 16rpx;
  border: 1rpx solid #2a2d3e;
  border-radius: 30rpx;
  font-size: 20rpx;
  color: #9ca3b8;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.filter-tag {
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  font-size: 20rpx;
  opacity: 0.35;
  border: 1rpx solid transparent;
}

.filter-tag.active { opacity: 1; border-color: currentColor; }

/* ===== 卡片列表（核心滚动区域） ===== */
.card-list {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}

.list-content {
  padding-top: calc(250rpx + env(safe-area-inset-top));
  padding-left: 20rpx;
  padding-right: 20rpx;
}

/* ===== 时代分组 ===== */
.era-section {
  margin-bottom: 16rpx;
}

.era-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.era-line {
  flex: 1;
  height: 1rpx;
  background: #2a2d3e;
}

.era-label {
  font-size: 22rpx;
  color: #5a6282;
  font-weight: 600;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

/* ===== 哲学家卡片 ===== */
.card-wrapper {
  margin-bottom: 20rpx;
}

.phil-card {
  background: #1a1d2e;
  border: 1rpx solid #2a2d3e;
  border-radius: 16rpx;
  overflow: hidden;
}

.card-hover {
  background: #1f2235;
  border-color: #3a3d4e;
}

/* -- 卡片头部 -- */
.card-header {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 24rpx 16rpx;
  gap: 20rpx;
}

.portrait-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 1rpx solid #2a2d3e;
}

.portrait-img {
  width: 80rpx;
  height: 80rpx;
}

.portrait-placeholder {
  width: 80rpx;
  height: 80rpx;
  background: #2a2d3e;
  display: flex;
  align-items: center;
  justify-content: center;
}

.portrait-initials {
  font-size: 24rpx;
  color: #9ca3b8;
  font-weight: 700;
}

.card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #e8eaf0;
  line-height: 1.3;
}

.card-years {
  font-size: 20rpx;
  color: #5a6282;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}

.tag-badge {
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  opacity: 0.7;
}

/* -- 分隔线 -- */
.card-divider {
  height: 1rpx;
  background: #2a2d3e;
  margin: 0 24rpx;
}

/* -- 思想列表 -- */
.idea-list {
  padding: 12rpx 16rpx 16rpx;
}

.idea-row {
  display: flex;
  align-items: center;
  padding: 10rpx 8rpx;
  border-radius: 8rpx;
  gap: 12rpx;
}

.idea-hover {
  background: rgba(255,255,255,0.03);
}

.idea-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.idea-text {
  flex: 1;
  font-size: 24rpx;
  color: #9ca3b8;
  line-height: 1.4;
  min-width: 0;
}

.idea-badges {
  display: flex;
  gap: 6rpx;
  flex-shrink: 0;
}

.badge {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.badge.agree {
  color: #4ade80;
  background: rgba(74,222,128,0.12);
}

.badge.disagree {
  color: #f87171;
  background: rgba(248,113,113,0.12);
}

/* ===== 索引抽屉 ===== */
.index-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.index-overlay.visible {
  opacity: 1;
  pointer-events: auto;
}

.index-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 72vw;
  background: #131520;
  border-left: 1rpx solid #2a2d3e;
  z-index: 101;
  transform: translateX(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
}

.index-panel.open { transform: translateX(0); }

.index-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 32rpx 20rpx;
  padding-top: calc(40rpx + env(safe-area-inset-top));
  border-bottom: 1rpx solid #2a2d3e;
}

.index-title { font-size: 28rpx; color: #c8a96e; font-weight: 700; }

.index-close {
  font-size: 44rpx;
  color: #6b7280;
  line-height: 1;
}

.index-list { flex: 1; }

.index-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #1e2130;
}

.index-hover { background: #1a1d2e; }

.index-name { font-size: 24rpx; color: #e8eaf0; }
.index-year { font-size: 20rpx; color: #5a6282; }

/* ===== 底部浮动信息栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(15,17,23,0.97) 60%, rgba(15,17,23,0));
  padding: 16rpx 32rpx 12rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 20;
}

.stats-text { font-size: 20rpx; color: #5a6282; }

.legend { display: flex; gap: 20rpx; }

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 18rpx;
  color: #5a6282;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.legend-dot.agree { background: #4ade80; }
.legend-dot.disagree { background: #f87171; }
