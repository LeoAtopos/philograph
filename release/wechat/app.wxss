/* app.wxss — 全局样式 */
page {
  background-color: #0f1117;
  color: #e8eaf0;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  box-sizing: border-box;
}

/* CSS Variables */
page {
  --bg-primary: #0f1117;
  --bg-card: #1a1d2e;
  --bg-panel: #131520;
  --text-primary: #e8eaf0;
  --text-secondary: #9ca3b8;
  --text-muted: #5a6282;
  --color-agree: #4ade80;
  --color-disagree: #f87171;
  --color-gold: #c8a96e;
  --color-accent: #7c8cff;
  --border-color: #2a2d3e;
  --radius: 12rpx;
  --radius-lg: 20rpx;
}

/* 通用工具类 */
.hidden { display: none !important; }

.text-muted { color: var(--text-muted); }
.text-secondary { color: var(--text-secondary); }
.text-gold { color: var(--color-gold); }
.text-agree { color: var(--color-agree); }
.text-disagree { color: var(--color-disagree); }

/* 标签颜色 */
